# PostgreSQL Database Connection URL (Prisma)
# Example for Neon/Supabase/RDS: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ledgerguard?schema=public"

# OpenRouter AI API Key (required for AI ambiguous resolution)
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# OpenRouter Free Model (Default: google/gemini-2.0-flash-lite-preview-02-05:free)
OPENROUTER_MODEL="google/gemini-2.0-flash-lite-preview-02-05:free"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Set to 'true' to enable offline mock mode for AI resolution without consuming OpenRouter credits
MOCK_OPENROUTER="false"

# Environment Mode
NODE_ENV="production"

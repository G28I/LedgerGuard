# PostgreSQL Database Connection URL (Prisma)
# Example for Neon/Supabase/RDS: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ledgerguard?schema=public"

# OpenRouter AI API Key (required for AI ambiguous resolution)
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# OpenRouter Free Model (Default: nvidia/llama-3.1-nemotron-70b-instruct:free)
OPENROUTER_MODEL="nvidia/llama-3.1-nemotron-70b-instruct:free"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Set to 'true' to enable offline mock mode for AI resolution without consuming OpenRouter credits
MOCK_OPENROUTER="false"

# Environment Mode
NODE_ENV="production"

# ==========================================
# AWS Infrastructure Configuration (Optional in local development)
# ==========================================
# AWS_REGION="us-east-1"
# AWS_SQS_RECONCILIATION_QUEUE_URL="https://sqs.us-east-1.amazonaws.com/123456789012/ledgerguard-reconciliation-queue"
# AWS_S3_REPORT_BUCKET="ledgerguard-audit-reports-prod"
# AWS_SECRETS_MANAGER_SECRET_ID="ledgerguard/production/credentials"
